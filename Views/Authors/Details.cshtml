@model Intalnirea1.Models.AuthorDetailsViewModel

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Author</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Author.FirstName)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Author.FirstName)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Author.LastName)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Author.LastName)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Author.FullName)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Author.FullName)
        </dd>
        <dt class="col-sm-2">Total comenzi</dt>
        <dd class="col-sm-10">@Model.TotalOrders</dd>
        <dt class="col-sm-2">Preț mediu</dt>
        <dd class="col-sm-10">@(Model.AveragePrice?.ToString("0.00") ?? "–")</dd>
    </dl>

    <h4>Cărți</h4>
    <table class="table table-sm">
        <thead>
            <tr><th>Titlu</th><th>Gen</th><th>Preț</th><th>Comenzi</th></tr>
        </thead>
        <tbody>
        @foreach (var b in Model.Books)
        {
            <tr>
                <td><a asp-controller="Books" asp-action="Details" asp-route-id="@b.ID">@b.Title</a></td>
                <td>@b.Genre</td>
                <td>@b.Price.ToString("0.00")</td>
                <td>@b.Orders</td>
            </tr>
        }
        </tbody>
    </table>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model.Author.ID">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
