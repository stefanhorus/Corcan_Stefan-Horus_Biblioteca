@model IEnumerable<Intalnirea1.Models.Order>

@{
    ViewData["Title"] = "Comenzi";
}

<h1>Comenzi</h1>

<p>
    <a asp-action="Create">Comandă nouă</a>
</p>

<form asp-action="Index" method="get" class="mb-3">
    Cititor:
    <select name="customerId" asp-items="ViewBag.CustomerFilter">
        <option value="">Toți</option>
    </select>
    <button type="submit" class="btn btn-primary btn-sm">Filtrează</button>
</form>

<table class="table">
    <thead>
        <tr>
            <th>Data</th>
            <th>Cititor</th>
            <th>Carte</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>@item.OrderDate.ToString("yyyy-MM-dd")</td>
            <td>@item.Customer.Name</td>
            <td>@item.Book.Title</td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.OrderID">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.OrderID">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.OrderID">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
