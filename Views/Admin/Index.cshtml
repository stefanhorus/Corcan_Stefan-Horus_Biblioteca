@{ ViewData["Title"] = "Administrare"; }

<h1>Administrare</h1>
<p><a asp-action="Log">Jurnalul recomandărilor</a></p>
@if (TempData["Msg"] is string msg) { <div class="alert alert-info">@msg</div> }
<p>Evaluări în baza de date: <strong>@ViewBag.Ratings</strong></p>

<form asp-action="ImportRatings" method="post" enctype="multipart/form-data" class="mb-4">
    <input type="file" name="file" accept=".csv" />
    <button type="submit" class="btn btn-primary btn-sm">Importă evaluări</button>
</form>

<form asp-action="Retrain" method="post">
    <button type="submit" class="btn btn-warning btn-sm">Reantrenează modelul de recomandare</button>
</form>
