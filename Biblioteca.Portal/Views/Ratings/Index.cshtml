@model RatingsIndexViewModel
@{ ViewData["Title"] = "Evaluările mele"; }

<h1>Evaluările unui cititor</h1>

<form asp-action="Index" method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <label asp-for="ReaderId" class="form-label"></label>
        <input asp-for="ReaderId" name="readerId" class="form-control" />
    </div>
    <div class="col-auto align-self-end">
        <button type="submit" class="btn btn-primary">Arată</button>
    </div>
</form>

@if (Model.Error is not null)
{
    <div class="alert alert-danger">@Model.Error</div>
}

@if (Model.ReaderId is not null && Model.Error is null)
{
    <p><a asp-action="Create" asp-route-readerId="@Model.ReaderId">Evaluare nouă</a></p>

    @if (Model.Ratings.Count == 0)
    {
        <p>Cititorul @Model.ReaderId nu are nicio evaluare.</p>
    }
    else
    {
        <table class="table">
            <thead><tr><th>Carte</th><th>Nota</th><th>Data</th><th></th></tr></thead>
            <tbody>
            @foreach (var r in Model.Ratings)
            {
                <tr>
                    <td>@r.Title</td>
                    <td>@r.Stars ★</td>
                    <td>@r.CreatedAt.ToDateTime().ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@r.Id" asp-route-readerId="@Model.ReaderId">Edit</a> |
                        <a asp-action="Delete" asp-route-id="@r.Id" asp-route-readerId="@Model.ReaderId">Delete</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    }
}
